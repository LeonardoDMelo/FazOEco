# =============================================================================
# Portal Automatizado de Ofertas e Afiliados — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# =============================================================================

# --- Aplicação ---
APP_NAME=FazOEco
APP_ENV=development
DEBUG=true

# --- PostgreSQL ---
POSTGRES_USER=fazoeeco
POSTGRES_PASSWORD=fazoeeco_secret
POSTGRES_DB=fazoeeco
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL assíncrona (asyncpg) usada pelo SQLAlchemy / Alembic
# Em Docker Compose o host é "db"; em desenvolvimento local use "localhost".
DATABASE_URL=postgresql+asyncpg://fazoeeco:fazoeeco_secret@localhost:5432/fazoeeco

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://frontend:3000
SECRET_KEY=change-me-to-a-long-random-secret-key

# Persistência sempre em UTC; exibição na API neste fuso
DISPLAY_TIMEZONE=America/Sao_Paulo

# --- Conectores de e-commerce ---
# true = usa mock_data (recomendado em desenvolvimento)
ENABLE_SIMULATION_MODE=true

# Amazon Product Advertising API
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Mercado Livre
MERCADOLIVRE_SITE_ID=MLB
MERCADOLIVRE_ACCESS_TOKEN=
MERCADOLIVRE_AFFILIATE_ID=

# Shopee Affiliate
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
